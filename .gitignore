.tern-port
*.tgz
*.pid
*.pid.lock
*.seed

# End-to-end install verification (scripts/e2e/verify-install.sh) — throwaway target repos.
# The tarball it installs from is already covered by the *.tgz rule above.
.e2e-workdir/

# Automation Workspace build and report outputs. A Workspace Baseline is a source tree;
# these four are regenerated from it by Maven and Allure on every run, carry no review value,
# and dwarf the source they came from. Scoped under platform_core_data/workspace/ so an
# identically-named folder anywhere else in the repo is untouched.
platform_core_data/workspace/**/target/
platform_core_data/workspace/**/allure-results/
platform_core_data/workspace/**/execution-summary/
platform_core_data/workspace/**/generatedReport_*.zip

# Module automation suite build and report outputs. Same reasoning as the workspace
# rules above: Maven, Allure, Extent and the SHAFT performance hook regenerate all of
# these from the tracked source tree on every run, they carry no review value, and they
# dwarf the source (allure-report ~23M, extent-reports ~18M for one Branch run).
# Execution evidence under runs/**/execution/artifacts/ is a deliverable and stays tracked.
platform_core_data/modules/**/target/
platform_core_data/modules/**/allure-report/
platform_core_data/modules/**/allure-results/
platform_core_data/modules/**/extent-reports/
platform_core_data/modules/**/performanceReport/
platform_core_data/modules/**/execution-summary/

# Workspace Automation Baseline build and report outputs (added 2026-08-17). Until promotion
# became terminal, execution happened in a module project and the baseline only ever received
# merged SOURCE — so it needed no rules of its own beyond the nested .gitignore it ships with
# (target/, *.class, allure-results/). A promoted module now executes and self-heals IN the
# baseline, which means Maven, Allure, Extent and the SHAFT performance hook all write here.
# Without these rules the first post-promotion run commits ~23M of Allure output into the
# authoritative source tree. Same reasoning as the module rules above, same four generators.
platform_core_data/automation_baseline/**/target/
platform_core_data/automation_baseline/**/allure-report/
platform_core_data/automation_baseline/**/allure-results/
platform_core_data/automation_baseline/**/extent-reports/
platform_core_data/automation_baseline/**/performanceReport/
platform_core_data/automation_baseline/**/execution-summary/
platform_core_data/automation_baseline/**/generatedReport_*.zip

# IntelliJ module descriptors — per-machine, regenerated on import.
*.iml

# Stage evidence is a deliverable, not a log. The `*.log` rule above matched
# `discovery/evidence/session_console.log` and dropped it from the commit
# silently — a console capture disappearing is the exact failure the evidence
# folder exists to prevent, and it is unrecoverable once the session is over.
# Re-included by path, so an incidental log anywhere else is still ignored.
!platform_core_data/modules/**/evidence/**/*.log
!platform_core_data/runs/**/artifacts/**/*.log

# Postman collections containing live, hardcoded API credentials (x-api-key /
# Client-Id as literal values, not {{variables}}) — never committed, same
# reasoning as credentials.json. If a future export resolves its secrets to
# Postman environment variables instead, it can be un-ignored then.
*.postman_collection.json
