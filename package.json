{
  "name": "agentic-ai-testing-platform",
  "version": "2.0.0",
  "description": "Spec-driven agentic QA pipeline — seven Claude Code skills you install into your own repository.",
  "keywords": [
    "testing",
    "qa",
    "automation",
    "playwright",
    "claude",
    "agentic",
    "test-generation"
  ],
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18.17"
  },
  "bin": {
    "agentic-testing": "bin/agentic-testing.js"
  },
  "main": "platform_core/tools/init/index.js",
  "exports": {
    ".": "./platform_core/tools/init/index.js",
    "./paths": "./platform_core/tools/platform_paths/paths.js",
    "./detect": "./platform_core/tools/mcp/stack_docs/detectProject.js",
    "./lifecycle": "./platform_core/tools/automation_lifecycle/index.js",
    "./run-manager": "./platform_core/tools/run_manager/index.js",
    "./module-manager": "./platform_core/tools/module_manager/index.js",
    "./test-suite-export": "./platform_core/tools/test_suite_export/index.js",
    "./execution-safety": "./platform_core/tools/execution_safety/index.js",
    "./observability": "./platform_core/tools/observability/index.js",
    "./init": "./platform_core/tools/init/index.js"
  },
  "files": [
    "bin/",
    "scripts/init.sh",
    "scripts/init.ps1",
    "platform_core/",
    "workflows_and_pipelines/",
    ".claude/skills/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"platform_core/tools/**/__tests__/*.test.js\" \"tests/contracts/*.test.js\"",
    "selftest": "node bin/agentic-testing.js doctor",
    "detect": "node bin/agentic-testing.js detect",
    "test:e2e": "bash scripts/e2e/verify-install.sh . .e2e-workdir",
    "verify:boundary": "node scripts/verifyBranchBoundary.js",
    "prepack": "node scripts/verifyBranchBoundary.js && node scripts/verifyPackable.js",
    "test:e2e:self-healing": "node tests/e2e/self_healing/selfHealing.e2e.js",
    "test:contracts": "node --test \"platform_core/tools/api_contract/__tests__/*.test.js\" \"tests/contracts/*.test.js\"",
    "test:contracts:matrix": "node tests/contracts/matrixRunner.js --markdown",
    "test:contracts:external": "node tests/contracts/external.js"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  },
  "peerDependencies": {
    "playwright": ">=1.61.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
